generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
  BILLING_ADMIN
  BROADCASTER
}

enum OrgMemberRole {
  OWNER
  STATION_MANAGER
  STATION_ADMIN
  MUSIC_MANAGER
  PLAYLIST_MANAGER
  DJ_PRESENTER
  ANALYTICS_VIEWER
  BILLING_MANAGER
  CUSTOM
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum StationStatus {
  OFFLINE
  PROVISIONING
  ON_AIR
  STOPPED
  ERROR
}

enum StreamAudioFormat {
  OPUS_320
  AAC_256
  MP3_320
  FLAC_LOSSLESS
}

enum PlaylistType {
  ROTATION
  SCHEDULED
  ONCE
  ADVANCED
}

enum PlayMode {
  SEQUENTIAL
  SHUFFLE
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  GRACE_PERIOD
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PaymentGatewayType {
  STRIPE
  PAYPAL
  AZAMPAY
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  UNCOLLECTIBLE
  VOID
}

enum TransactionStatus {
  SUCCESS
  PENDING
  FAILED
  REFUNDED
}

// -------------------------------------------------------------
// USER & SESSIONS
// -------------------------------------------------------------

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String
  name             String
  avatarUrl        String?
  phoneNumber      String?
  role             UserRole             @default(BROADCASTER)
  isEmailVerified  Boolean              @default(false)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  memberships      OrganizationMember[]
  sessions         Session[]
  auditLogs        AuditLog[]
  djAccounts       DjAccount[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("sessions")
}

// -------------------------------------------------------------
// ORGANIZATION & MULTI-TENANCY
// -------------------------------------------------------------

model Organization {
  id                String               @id @default(uuid())
  name              String
  slug              String               @unique
  logoUrl           String?
  contactEmail      String
  timezone          String               @default("UTC")
  defaultLanguage   String               @default("en")
  storageQuotaBytes BigInt               @default(5368709120) // 5GB default
  storageUsedBytes  BigInt               @default(0)
  maxStations       Int                  @default(2)
  maxBandwidthBytes BigInt               @default(107374182400) // 100GB default
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  members           OrganizationMember[]
  invites           OrganizationInvite[]
  customRoles       CustomRole[]
  stations          Station[]
  subscriptions     Subscription[]
  invoices          Invoice[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  auditLogs         AuditLog[]

  @@map("organizations")
}

model OrganizationMember {
  id           String        @id @default(uuid())
  orgId        String
  userId       String
  role         OrgMemberRole @default(STATION_MANAGER)
  customRoleId String?
  joinedAt     DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole   CustomRole?   @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([orgId, userId])
  @@map("organization_members")
}

model CustomRole {
  id          String               @id @default(uuid())
  orgId       String
  name        String
  description String?
  permissions String[]             // Array of permission strings
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]

  @@map("custom_roles")
}

model OrganizationInvite {
  id        String        @id @default(uuid())
  orgId     String
  email     String
  role      OrgMemberRole @default(STATION_MANAGER)
  token     String        @unique
  status    InviteStatus  @default(PENDING)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("organization_invites")
}

// -------------------------------------------------------------
// STATIONS & BROADCASTING
// -------------------------------------------------------------

model Station {
  id               String               @id @default(uuid())
  orgId            String
  name             String
  slug             String               @unique
  description      String?
  genre            String               @default("Variety")
  logoUrl          String?
  playerBannerUrl  String?
  playerAccentColor String              @default("#00E5FF")
  streamKey        String               @unique @default(uuid())
  sourcePassword   String
  adminPassword    String
  backendStatus    StationStatus        @default(OFFLINE)
  autoDjEnabled    Boolean              @default(true)
  crossfadeSec     Float                @default(2.5)
  defaultBitrate   Int                  @default(320)
  defaultFormat    StreamAudioFormat    @default(OPUS_320)
  portIngest       Int                  @unique
  portRelay        Int                  @default(8010)
  publicPageEnabled Boolean             @default(true)
  isPublicListed   Boolean              @default(true)
  currentListeners Int                  @default(0)
  peakListeners    Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization     Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  mounts           StreamMount[]
  processState     StationProcessState?
  mediaFolders     MediaFolder[]
  mediaFiles       MediaFile[]
  playlists        Playlist[]
  shows            Show[]
  schedules        StationSchedule[]
  djAccounts       DjAccount[]
  listenerSessions StreamListenerSession[]
  broadcastLogs    BroadcastLog[]
  bandwidthRollups BandwidthRollup[]

  @@index([orgId])
  @@map("stations")
}

model StreamMount {
  id               String               @id @default(uuid())
  stationId        String
  mountPath        String               // e.g. /live, /autodj
  format           StreamAudioFormat    @default(OPUS_320)
  bitrate          Int                  @default(320)
  isDefault        Boolean              @default(false)
  isPublic         Boolean              @default(true)
  maxListeners     Int                  @default(1000)
  currentListeners Int                  @default(0)
  fallbackMount    String?
  createdAt        DateTime             @default(now())

  station          Station              @relation(fields: [stationId], references: [id], onDelete: Cascade)
  listenerSessions StreamListenerSession[]

  @@unique([stationId, mountPath])
  @@map("stream_mounts")
}

model StationProcessState {
  id               String    @id @default(uuid())
  stationId        String    @unique
  pid              Int?
  memoryMb         Float     @default(0)
  cpuUsage         Float     @default(0)
  bufferLatencyMs  Float     @default(0)
  jitterMs         Float     @default(0)
  encoderHealth    Float     @default(100)
  lastHeartbeat    DateTime  @default(now())
  autodjMetaJson   String    @default("{}")
  liquidsoapConfigPath String?
  supervisorPid    Int?

  station          Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@map("station_process_states")
}

// -------------------------------------------------------------
// MEDIA & PLAYLISTS
// -------------------------------------------------------------

model MediaFolder {
  id        String      @id @default(uuid())
  stationId String
  name      String
  parentId  String?
  createdAt DateTime    @default(now())

  station   Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  parent    MediaFolder? @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderHierarchy")
  files     MediaFile[]

  @@map("media_folders")
}

model MediaFile {
  id               String         @id @default(uuid())
  stationId        String
  folderId         String?
  originalFilename String
  storageKey       String         @unique
  fileSize         BigInt
  mimeType         String         @default("audio/mpeg")
  duration         Float          @default(0)
  title            String
  artist           String         @default("Unknown Artist")
  album            String?
  genre            String?
  year             Int?
  bpm              Float?
  lufs             Float          @default(-14.0)
  cueInSec         Float          @default(0)
  cueOutSec        Float?
  artworkUrl       String?
  waveformJson     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  station          Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)
  folder           MediaFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  playlistItems    PlaylistItem[]
  broadcastLogs    BroadcastLog[]

  @@index([stationId])
  @@map("media_files")
}

model Playlist {
  id         String         @id @default(uuid())
  stationId  String
  name       String
  type       PlaylistType   @default(ROTATION)
  weight     Int            @default(5)
  isActive   Boolean        @default(true)
  playMode   PlayMode       @default(SHUFFLE)
  startTime  String?        // HH:mm for scheduled
  endTime    String?        // HH:mm
  daysOfWeek Int[]          // [0, 1, 2, 3, 4, 5, 6]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  station    Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)
  items      PlaylistItem[]
  schedules  StationSchedule[]

  @@map("playlists")
}

model PlaylistItem {
  id          String    @id @default(uuid())
  playlistId  String
  mediaFileId String
  order       Int       @default(0)
  cueFadeSec  Float     @default(2.0)
  createdAt   DateTime  @default(now())

  playlist    Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@index([playlistId, order])
  @@map("playlist_items")
}

// -------------------------------------------------------------
// SHOWS & LIVE PRESENTERS
// -------------------------------------------------------------

model Show {
  id          String            @id @default(uuid())
  stationId   String
  title       String
  description String?
  bannerUrl   String?
  hostName    String
  colorCode   String            @default("#00E5FF")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  station     Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  schedules   StationSchedule[]

  @@map("shows")
}

model StationSchedule {
  id          String   @id @default(uuid())
  stationId   String
  showId      String?
  playlistId  String?
  djUserId    String?
  title       String
  dayOfWeek   Int      // 0-6
  startTime   String   // HH:mm
  endTime     String   // HH:mm
  isRecurring Boolean  @default(true)
  createdAt   DateTime @default(now())

  station     Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  show        Show?     @relation(fields: [showId], references: [id], onDelete: SetNull)
  playlist    Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@map("station_schedules")
}

model DjAccount {
  id            String   @id @default(uuid())
  stationId     String
  userId        String?
  username      String
  passwordHash  String
  mountAllowed  String   @default("/live")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  station       Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([stationId, username])
  @@map("dj_accounts")
}

// -------------------------------------------------------------
// TELEMETRY & ANALYTICS
// -------------------------------------------------------------

model StreamListenerSession {
  id               String       @id @default(uuid())
  stationId        String
  mountId          String?
  listenerIp       String
  userAgent        String?
  clientCountry    String?      @default("Unknown")
  clientCity       String?
  connectedAt      DateTime     @default(now())
  disconnectedAt   DateTime?
  durationSeconds  Int          @default(0)
  bytesTransferred BigInt       @default(0)

  station          Station      @relation(fields: [stationId], references: [id], onDelete: Cascade)
  mount            StreamMount? @relation(fields: [mountId], references: [id], onDelete: SetNull)

  @@index([stationId, connectedAt])
  @@map("stream_listener_sessions")
}

model BroadcastLog {
  id              String     @id @default(uuid())
  stationId       String
  mediaFileId     String?
  trackTitle      String
  artist          String
  album           String?
  startedAt       DateTime   @default(now())
  endedAt         DateTime?
  durationSeconds Float      @default(0)
  listenersPeak   Int        @default(0)

  station         Station    @relation(fields: [stationId], references: [id], onDelete: Cascade)
  mediaFile       MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)

  @@index([stationId, startedAt])
  @@map("broadcast_logs")
}

model BandwidthRollup {
  id                     String   @id @default(uuid())
  stationId              String
  date                   DateTime @db.Date
  totalSecondsListened   BigInt   @default(0)
  totalBytesServed       BigInt   @default(0)
  peakConcurrentListeners Int      @default(0)

  station                Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, date])
  @@map("bandwidth_rollups")
}

// -------------------------------------------------------------
// SUBSCRIPTIONS & BILLING
// -------------------------------------------------------------

model SubscriptionPlan {
  id                     String         @id @default(uuid())
  name                   String
  slug                   String         @unique
  description            String?
  monthlyPriceUsd        Decimal        @db.Decimal(10, 2)
  annualPriceUsd         Decimal        @db.Decimal(10, 2)
  maxStations            Int            @default(1)
  maxConcurrentListeners Int            @default(100)
  maxStorageGb           Int            @default(5)
  maxBandwidthGb         Int            @default(100)
  customRingbackAllowed  Boolean        @default(false)
  adFreeAllowed          Boolean        @default(false)
  multiOperatorAllowed   Boolean        @default(false)
  analyticsLevel         String         @default("STANDARD")
  isPublic               Boolean        @default(true)
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  subscriptions          Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  orgId              String
  planId             String
  status             SubStatus          @default(ACTIVE)
  billingCycle       BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  paymentGateway     PaymentGatewayType @default(STRIPE)
  gatewaySubId       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  invoices           Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id            String               @id @default(uuid())
  orgId         String
  subscriptionId String?
  invoiceNumber String               @unique
  amountDue     Decimal              @db.Decimal(10, 2)
  amountPaid    Decimal              @default(0) @db.Decimal(10, 2)
  currency      String               @default("USD")
  status        InvoiceStatus        @default(OPEN)
  paymentMethod String?
  paidAt        DateTime?
  dueDate       DateTime
  pdfUrl        String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  organization  Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription  Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  transactions  PaymentTransaction[]

  @@map("invoices")
}

model PaymentTransaction {
  id             String             @id @default(uuid())
  invoiceId      String
  orgId          String
  gateway        PaymentGatewayType
  transactionRef String             @unique
  amount         Decimal            @db.Decimal(10, 2)
  currency       String             @default("USD")
  status         TransactionStatus  @default(PENDING)
  rawResponse    String?
  createdAt      DateTime           @default(now())

  invoice        Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model PaymentGatewayConfig {
  id          String             @id @default(uuid())
  gateway     PaymentGatewayType @unique
  isEnabled   Boolean            @default(false)
  isLiveMode  Boolean            @default(false)
  configJson  String             @default("{}") // Encrypted / masked credentials
  updatedAt   DateTime           @updatedAt

  @@map("payment_gateway_configs")
}

// -------------------------------------------------------------
// DEVELOPER PLATFORM & AUDIT
// -------------------------------------------------------------

model ApiKey {
  id          String       @id @default(uuid())
  orgId       String
  name        String
  keyPrefix   String       // First 8 characters e.g. "rf_live_"
  keyHash     String       @unique // Argon2 or sha256 hash of the full secret
  scopes      String[]     // e.g. ["stations:read", "media:write"]
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model WebhookEndpoint {
  id                 String               @id @default(uuid())
  orgId              String
  url                String
  secret             String               // HMAC signing secret
  eventSubscriptions String[]             // e.g. ["station.started", "track.played"]
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())

  organization       Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveryLogs       WebhookDeliveryLog[]

  @@map("webhook_endpoints")
}

model WebhookDeliveryLog {
  id             String          @id @default(uuid())
  endpointId     String
  eventType      String
  payload        String
  responseStatus Int?
  responseBody   String?
  durationMs     Int             @default(0)
  success        Boolean         @default(false)
  attempt        Int             @default(1)
  createdAt      DateTime        @default(now())

  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@map("webhook_delivery_logs")
}

model AuditLog {
  id           String       @id @default(uuid())
  orgId        String?
  userId       String?
  action       String       // e.g. "station.create", "member.invite"
  resourceType String       // e.g. "Station", "User"
  resourceId   String?
  ipAddress    String?
  metadata     String?      // JSON string of parameters or old/new values
  createdAt    DateTime     @default(now())

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@map("audit_logs")
}
